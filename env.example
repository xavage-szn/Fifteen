# ─── Flutterwave ──────────────────────────────────────────────────────────────
# Get these from: Flutterwave Dashboard → Settings → API Keys
# Test keys have the _TEST_ prefix; live keys have _LIVE_
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X   # Server-side Bearer token
FLW_ENCRYPTION_KEY=FLWSECKxxxxxxxxxxxxxxxx                   # Card charge encryption (server-side only)
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X  # Frontend inline SDK (safe to expose)

# ─── Monierate (parallel/black-market NGN/USD rate) ───────────────────────────
# Sign up at https://monierate.com/developers
MONIERATE_API_KEY=your_monierate_api_key_here

# ─── Treasury wallet ──────────────────────────────────────────────────────────
# The private key of the wallet that holds USDC and sends it to buyers.
# Fund with testnet USDC via the Arc Studio sidebar "Get test USDC" button.
# NEVER commit a real private key. Use a dedicated hot-wallet with a capped balance.
TREASURY_PRIVATE_KEY=0xyour_treasury_private_key_here

# ─── Per-transaction access token secret ─────────────────────────────────────
# 64-char hex string used to HMAC-sign per-transaction tokens.
# If omitted, a random secret is generated at startup (tokens won't survive restart).
# Generate with: openssl rand -hex 32
# TOKEN_SECRET=your_64_char_hex_secret_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
# Run supabase-schema.sql in the Supabase SQL editor first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...          # Service role key — server-side only, never expose to browser
SUPABASE_PUBLISHABLE_KEY=sb_publishable_... # Anon key — used by frontend for auth only

# VITE_ prefix exposes these to the browser (safe — these are public keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...  # Same as SUPABASE_PUBLISHABLE_KEY

# ─── Optional overrides ───────────────────────────────────────────────────────
# Platform fee in basis points (default: 150 = 1.5%)
# PLATFORM_FEE_BPS=150

# Per-transaction NGN ceiling (default: 500000 = ₦500,000)
# MAX_NGN_AMOUNT=500000
